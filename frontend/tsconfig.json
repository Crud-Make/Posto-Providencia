{
  "compilerOptions": {
    "target": "ES2022",
    // Ligado em 17/09/2026. Sem `strict` o TypeScript roda em modo frouxo: campo que o
    // banco permite NULL era lido como se nunca fosse nulo, e metade das regras
    // type-aware do typescript-eslint não funciona sem `strictNullChecks` (o linter
    // avisa e desliga a regra). `packages/utils` — o módulo canônico do dinheiro, com os
    // 18 golden masters — já passava limpo; os 43 erros estavam todos em `apps/`.
    "strict": true,
    // Ligadas em 18/09/2026 sob CATRACA (scripts/catraca.mjs). Abriram ~365 erros no
    // código que já existia — quase todos de `noUncheckedIndexedAccess`, vários dentro de
    // fórmula de dinheiro — e corrigir tudo de uma vez tocaria o dinheiro sem golden por
    // arquivo. Os erros atuais estão congelados em `.catraca/tsc.json`; erro NOVO reprova
    // o `type-check`, e a lista só pode diminuir.
    //
    // `module`/`moduleResolution` ficam em ESNext/bundler de propósito: o Vite resolve o
    // import, não o Node. `NodeNext` exigiria extensão `.js` em todo import relativo.
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ],
      "@app/*": [
        "./apps/web/src/app/*"
      ],
      "@pages/*": [
        "./apps/web/src/pages/*"
      ],
      "@widgets/*": [
        "./apps/web/src/widgets/*"
      ],
      "@features/*": [
        "./apps/web/src/features/*"
      ],
      "@entities/*": [
        "./apps/web/src/entities/*"
      ],
      "@shared/*": [
        "./apps/web/src/shared/*"
      ],
      "@posto/types": [
        "./packages/types/src/index.ts"
      ],
      "@posto/utils": [
        "./packages/utils/src/index.ts"
      ],
      "@posto/api-core": [
        "./packages/api-core/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "netlify",
    "*.cjs",
    "create_*.ts",
    "verify_*.ts",
    "reset_*.ts",
    "spikes",
    "supabase/functions"
  ]
}