{
  "name": "posto-providencia-monorepo",
  "private": true,
  "version": "4.0.0",
  "packageManager": "bun@1.3.6",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --bun vite --port 3015",
    "build": "bun -e \"Bun.write('./apps/web/public/version.json', JSON.stringify({version: Date.now().toString()}))\" && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "lint": "oxlint .",
    "type-check": "bun scripts/catraca.mjs tsc",
    "type-check:bruto": "tsc --noEmit",
    "test": "TZ=America/Sao_Paulo vitest run",
    "test:watch": "TZ=America/Sao_Paulo vitest",
    "test:golden": "TZ=America/Sao_Paulo bun test packages/utils/src/*.golden.spec.ts $(find apps/web/src -name '*.golden.spec.ts')",
    "lint:eslint": "bun scripts/catraca.mjs eslint",
    "catraca:atualizar": "bun scripts/catraca.mjs tsc --atualizar && bun scripts/catraca.mjs eslint --atualizar"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@posto/api-core": "workspace:*",
    "@posto/types": "workspace:*",
    "@posto/utils": "workspace:*",
    "@supabase/supabase-js": "^2.97.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.560.0",
    "neverthrow": "^8.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "whatwg-fetch": "^3.6.20",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@bufferings/eslint-plugin-neverthrow": "^0.3.0",
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.19.2",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.83.0",
    "pg": "^8.16.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
