        "apps/web/src/components/login/index.tsx",
        "apps/web/src/components/registro-compras/SecaoVendas.tsx",
        "apps/web/src/services/api/aggregator.service.ts",
        "apps/web/src/services/api/reset.service.ts",
        "apps/web/src/shared/ui/ValidationAlert.tsx",
        "apps/web/src/widgets/planilha-do-mes/model/use-planilha-do-banco.ts",
        "apps/web/src/widgets/planilha-do-mes/ui/planilha-do-mes.tsx",
