# Ambiente de PRODUÇÃO do backend (#105). Copie para `deploy/.env.producao` e preencha.
#
#   cp deploy/.env.producao.exemplo deploy/.env.producao
#
# O arquivo real NÃO é versionado (segredo), e é lido por `deploy/sobe.sh`, que o passa para o
# container como `env_file` e usa o `DOMINIO_API`/`ACME_EMAIL` para o Caddy do edge.
#
# Metade destas chaves o `entrypoint.sh` RECUSA subir sem: APP_KEY, DB_HOST, SUPABASE_JWT_SECRET e
# CORS_ORIGINS. Não é aviso — o container para, e o `docker compose logs api` diz qual falta.

# ── O edge (não vai para o PHP; o `sobe.sh` exporta para o compose) ───────────────────────────
# O domínio da API. O DNS dele tem de JÁ apontar para esta VPS, senão o Let's Encrypt não emite.
DOMINIO_API=api.posto.exemplo.com.br
# E-mail que o Let's Encrypt usa para avisar de vencimento/problema no certificado.
ACME_EMAIL=voce@exemplo.com.br

# ── Aplicação ─────────────────────────────────────────────────────────────────────────────────
APP_NAME="Posto Providência"
APP_ENV=production
# Gere com: php artisan key:generate --show   (no backend/, com as dependências instaladas)
APP_KEY=
# NUNCA true em produção: a resposta de erro passaria a mostrar caminho de arquivo e trecho de
# código para quem chamar a API.
APP_DEBUG=false
# A URL pública da API, a mesma do DOMINIO_API — o Laravel usa para montar URL absoluta.
APP_URL=https://api.posto.exemplo.com.br

# ── Banco: o Postgres do SUPABASE, no ensaio de 27/09/2026 ────────────────────────────────────
# Enquanto o ensaio vale, a API lê e escreve no MESMO banco que o painel já usa no Supabase. Isso
# é deliberado: evita migrar dinheiro de produção às pressas. A migração para o Postgres da VPS é
# passo próprio, com conferência POR VALOR (`docs/design/cutover.md`).
#
# O host sai do painel do Supabase: Settings → Database → Connection string. Use o do pooler se
# quiser; com 12 frentistas, a conexão direta também serve.
DB_CONNECTION=pgsql
DB_HOST=db.SEU-PROJETO.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
# O Supabase exige TLS. Com `prefer` a conexão sobe sem cifra, em silêncio — e o banco está na
# internet.
DB_SSLMODE=require
# UTC, como o Supabase responde. NÃO troque por America/Sao_Paulo: o mesmo SQL passa a devolver
# outro número, e um recorte de janeiro já perdeu o dia 01 inteiro (R$ 9.430,34) por causa disso.
DB_TIMEZONE=UTC

# ── Quem pode chamar a API pelo navegador ─────────────────────────────────────────────────────
# Obrigatória. Sem ela o container RECUSA subir, porque o padrão do Laravel é `*` e isso deixaria
# qualquer site chamar esta API. Uma ou mais origens, separadas por vírgula, SEM barra no fim.
# Os domínios de preview da Vercel mudam a cada deploy — se precisar deles, liste cada um.
CORS_ORIGINS=https://posto.exemplo.com.br

# ── Autenticação na transição ─────────────────────────────────────────────────────────────────
# O painel continua logando pelo Supabase Auth; o Laravel só CONFERE o token que já existe e acha
# o `Usuario` por `auth_user_id`. Este é o valor de Settings → API → JWT Secret.
# Sem ele, TODO login responde 401 — inclusive o do dono.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCIA=authenticated
# Folga em segundos ao conferir `exp`/`nbf`: relógio de VPS atrasado não deve derrubar sessão.
SUPABASE_JWT_FOLGA_SEGUNDOS=10

# ── O resto: sem servidor externo, de propósito ───────────────────────────────────────────────
# Sessão, cache e fila ficam em arquivo/síncrono. Redis entra quando houver fila de verdade —
# hoje a escrita é síncrona e o volume é de 12 frentistas, não de milhares.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=log

LOG_CHANNEL=stack
LOG_LEVEL=warning