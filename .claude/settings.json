{
  "permissions": {
    "allow": [],
    "deny": [
      "mcp__supabase__apply_migration",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__rebase_branch",
      "mcp__supabase__reset_branch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/higiene.py\"",
            "timeout": 20,
            "statusMessage": "Conferindo saúde do ferramental"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/diario-de-sessoes.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/roteia-consulta.py\"",
            "timeout": 10,
            "statusMessage": "Encaminhando para o agente certo"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/so-fable-na-formula.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo se o modelo pode mexer em fórmula"
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/forca-delegacao.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo teto de leitura da thread"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protege-dados.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo fonte auditável"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protege-git.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo regras de git"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protege-dados.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo fonte auditável"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/checklist-commit.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo checklist de commit"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/diario-de-sessoes.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/controller-nao-fala-com-domain.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/dinheiro-quantiza-por-emcentavos.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/portao-golden.py\"",
            "timeout": 10,
            "statusMessage": "Conferindo cobertura de golden master"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/trava-ts.py\"",
            "timeout": 100,
            "statusMessage": "Lint type-aware no arquivo editado (catraca)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/trava-php.py\"",
            "timeout": 120,
            "statusMessage": "Gates do backend no arquivo PHP editado"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|mcp__supabase__execute_sql|mcp__supabase__apply_migration",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/diario-de-sessoes.py\""
          }
        ]
      }
    ]
  }
}
