#!/bin/sh
# pre-commit do Posto Providência (CLAUDE.md §7): gates do PHP só quando há .php no índice.
# O lado TS não é bloqueado por ferramenta PHP, e vice-versa. Instalar: scripts/instala-hooks.sh
raiz="$(git rev-parse --show-toplevel)"
php_no_indice="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^backend/.*\.php$' || true)"
if [ -n "$php_no_indice" ]; then
    echo "[pre-commit] .php no índice — rodando Pint, PHPStan, PHPMD e Deptrac em backend/"
    cd "$raiz/backend" || exit 1
    composer lint --quiet     || { echo "[pre-commit] Pint reprovou: rode 'composer lint:corrige'"; exit 1; }
    composer analise --quiet  || { echo "[pre-commit] PHPStan reprovou"; exit 1; }
    composer md --quiet       || { echo "[pre-commit] PHPMD reprovou (CCN > 10?)"; exit 1; }
    composer deptrac --quiet  || { echo "[pre-commit] Deptrac reprovou: dependência fora das camadas"; exit 1; }
fi
ts_no_indice="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^frontend/.*\.(ts|tsx)$' || true)"
if [ -n "$ts_no_indice" ]; then
    echo "[pre-commit] .ts/.tsx no índice — rodando oxlint em frontend/"
    cd "$raiz/frontend" || exit 1
    bun run lint >/dev/null || { echo "[pre-commit] oxlint reprovou"; exit 1; }
    # oxlint lê sintaxe, não tipos: `any`, neverthrow, promise solta, FSD e toISOString só o
    # ESLint type-aware vê. Até 18/09 ele rodava só no CI. Aqui roda só nos arquivos do
    # índice (~3 s) e pela catraca: dívida congelada passa, erro novo reprova.
    arquivos="$(printf '%s\n' "$ts_no_indice" | sed 's#^frontend/##')"
    # shellcheck disable=SC2086
    bun scripts/catraca.mjs eslint $arquivos || { echo "[pre-commit] ESLint reprovou: erro novo nos arquivos acima"; exit 1; }
fi
exit 0
