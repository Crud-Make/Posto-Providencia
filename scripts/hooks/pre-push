#!/bin/sh
# pre-push do Posto Providência — ENXUGADO em 24/09/2026 por decisão do dono.
#
# Faz DUAS coisas, e só:
#   1. recusa push para a `main` (CLAUDE.md §0: branch por issue e PR, sempre);
#   2. roda o golden master (`bun run test:golden`) — a trava do dinheiro (DOM-1).
#
# Por que só isso: o CI (`.github/workflows/ci.yml`) roda oxlint, eslint completo, type-check,
# vitest, build e `composer gates` em TODO pull request, e a proteção da `main` e da `fase-a`
# exige os jobs `build` e `backend` verdes antes do merge. A versão anterior deste hook
# (18/09 → 24/09) repetia tudo isso num worktree temporário, com `bun install` e
# `composer install` do zero: ~4 min por push para provar o que o CI ia provar de novo.
#
# O golden fica aqui porque é a ÚNICA peça que o CI não consegue rodar: depende de
# `docs/data/*.sqlite`, dado financeiro real do posto, gitignored desde 2026-07-29. Custa
# ~0,5 s (medido em 24/09).
#
# LIMITE, dito com todas as letras: o golden roda sobre a ÁRVORE deste checkout, não sobre o
# commit que sobe. Quando o commit não é o HEAD, ou há mudança não commitada em frontend/, o
# hook avisa — e ainda assim roda, porque o custo de um falso vermelho aqui é maior do que o
# de um aviso lido. Quem quiser a prova sobre o commit exato, faz `git stash` antes do push.
#
# Canários: scripts/hooks/testa-pre-push.sh   ·   Instalar: scripts/instala-hooks.sh
# Emergência: `git push --no-verify` passa por cima (é do git). Quem usar, diz no PR por quê.

raiz="$(git rev-parse --show-toplevel)"
ZERO="0000000000000000000000000000000000000000"
head_sha="$(git rev-parse HEAD)"

refs="$(mktemp)"
cat > "$refs"
trap 'rm -f "$refs"' EXIT INT TERM

# ── 1. main é proibida ─────────────────────────────────────────────────────────
while read -r _ref_local _sha_local ref_remoto _sha_remoto; do
    case "$ref_remoto" in
        refs/heads/main|refs/heads/master)
            echo "[pre-push] BLOQUEADO: push direto para $ref_remoto."
            echo "[pre-push] O CLAUDE.md §0 proíbe: branch por issue e PR, sempre."
            exit 1
            ;;
    esac
done < "$refs"

# ── 2. há árvore para testar? ──────────────────────────────────────────────────
# Só deleção de branch remota (sha zero) não tem o que testar.
tem_commit=0
while read -r _ref_local sha_local _ref_remoto _sha_remoto; do
    [ -n "$sha_local" ] && [ "$sha_local" != "$ZERO" ] && tem_commit=1
    if [ -n "$sha_local" ] && [ "$sha_local" != "$ZERO" ] && [ "$sha_local" != "$head_sha" ]; then
        echo "[pre-push] AVISO: o commit que sobe ($(git rev-parse --short "$sha_local")) não é o HEAD deste checkout — o golden abaixo é sobre a árvore atual."
    fi
done < "$refs"
[ "$tem_commit" -eq 0 ] && exit 0

if [ -n "$(git status --porcelain --untracked-files=no -- frontend 2>/dev/null)" ]; then
    echo "[pre-push] AVISO: frontend/ tem mudança não commitada — o golden abaixo é sobre a árvore, não sobre o commit."
fi

# ── 3. golden master ───────────────────────────────────────────────────────────
if [ ! -d "$raiz/docs/data" ]; then
    echo "[pre-push] ✗ $raiz/docs/data não existe — sem o dado real o golden não roda, e sem golden não dá para afirmar que o dinheiro está certo."
    echo "[pre-push]   Em worktree: aponte docs/data para o do checkout principal (ver memória 'worktree não herda dependências')."
    exit 1
fi

cd "$raiz/frontend" || exit 1
log="$(mktemp)"
echo "[pre-push] golden masters (bun run test:golden)…"
if bun run test:golden >"$log" 2>&1; then
    rm -f "$log"
    echo "[pre-push] ✓ golden verde — push liberado. Lint, type-check, vitest e gates PHP ficam com o CI do PR."
    exit 0
fi

echo "[pre-push] ✗ GOLDEN MASTER reprovou — alguma fórmula de dinheiro mudou de resultado. Não se resolve ajustando o teste. Últimas linhas:"
tail -n 25 "$log" | sed 's/^/[pre-push]     /'
rm -f "$log"
echo ""
echo "[pre-push] ══════════════════════════════════════════════════════════════"
echo "[pre-push] PUSH BLOQUEADO: o dinheiro não fecha. Tem posto em produção do outro lado."
echo "[pre-push] ══════════════════════════════════════════════════════════════"
exit 1
