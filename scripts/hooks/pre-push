#!/bin/sh
# pre-push do Posto Providência (CLAUDE.md §7 e a trava geral da refatoração Laravel).
#
# REGRA: não se dá push antes de o sistema estar rodando. O painel e os dois PWAs estão em
# produção com dinheiro real do posto; push de árvore quebrada quebra o posto, não o repo.
#
# Roda a suíte INTEIRA, não só o que mudou — "o sistema está rodando" é uma afirmação sobre o
# sistema, não sobre o diff. Push é raro; esperar aqui é barato perto de derrubar o Elias.
#
# ── O QUE ESTE HOOK TESTA (18/09/2026) ────────────────────────────────────────
# O COMMIT QUE SOBE, sempre. Nunca a árvore de onde se empurra. Dois verdes falsos provados
# por canário antes desta versão:
#   1. A versão original testava o working tree e descartava o sha do stdin. Commit com teste
#      Pest vermelho + o arquivo apagado só no working tree → "push liberado".
#   2. A primeira correção tinha atalho "sha == HEAD → testa a árvore atual" (o mesmo verde
#      falso do item 1) e, fora do HEAD, ligava backend/vendor por symlink. O autoload do
#      Composer resolve $baseDir pelo caminho REAL do vendor, então App\ e Tests\ vinham da
#      árvore de origem: defeito plantado em App\ sumia, e a suíte quebrava com 36 erros de
#      bootstrap, bloqueando todo push fora do HEAD pelo motivo errado.
#
# Por isso, para CADA ref que sobe (menos deleção):
#   • worktree temporária destacada naquele sha, sem atalho de HEAD;
#   • dependências PRÓPRIAS nela: `composer install` e `bun install --frozen-lockfile`
#     (nunca symlink de vendor/ ou node_modules — os dois resolvem caminho pelo lugar real);
#   • backend/.env copiado; docs/data (dado, não código) por symlink só dentro dela;
#   • os mesmos gates de sempre rodam lá dentro; o .deptrac.cache sujo fica lá, não aqui;
#   • a worktree é removida em qualquer saída (trap), inclusive erro e Ctrl-C.
#
# Teste do próprio hook (canários): scripts/hooks/testa-pre-push.sh
# Instalar: scripts/instala-hooks.sh
#
# Emergência: `git push --no-verify` passa por cima (é do git, não dá para impedir). Se você
# usar, o combinado é dizer no PR por que usou.

raiz="$(git rev-parse --show-toplevel)" || exit 1
comum="$(git rev-parse --path-format=absolute --git-common-dir)" || exit 1
# Checkout principal: fonte de reserva do .env e do docs/data quando a worktree que empurra
# não tem os seus.
principal="$(dirname "$comum")"
cd "$raiz" || exit 1
# O git pode exportar GIT_DIR/GIT_INDEX_FILE para o hook; dentro da worktree temporária eles
# apontariam para o repositório errado.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

ZERO="0000000000000000000000000000000000000000"
falhou=0

# O stdin só pode ser lido uma vez. Guarda em arquivo para percorrer duas vezes sem subshell.
refs="$(mktemp)"
temporarios="$(mktemp)"
cat > "$refs"

limpar() {
    cd "$raiz" 2>/dev/null || cd / || true
    if [ -f "$temporarios" ]; then
        while read -r wt; do
            [ -n "$wt" ] || continue
            git -C "$raiz" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
        done < "$temporarios"
    fi
    git -C "$raiz" worktree prune >/dev/null 2>&1
    rm -f "$refs" "$temporarios"
}
trap limpar EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# ── 1. main é proibida (CLAUDE.md §0) ──────────────────────────────────────────
while read -r _ref_local _sha_local ref_remoto _sha_remoto; do
    case "$ref_remoto" in
        refs/heads/main|refs/heads/master)
            echo "[pre-push] BLOQUEADO: push direto para $ref_remoto."
            echo "[pre-push] O CLAUDE.md §0 proíbe: branch por issue e PR, sempre."
            exit 1
            ;;
    esac
done < "$refs"

# ── 2. utilitários ─────────────────────────────────────────────────────────────
# Mostra o fim do log de um passo que reprovou — o motivo tem de aparecer aqui, não num
# "rode de novo para ver".
mostrar_log() {
    echo "[pre-push]   ── últimas linhas de $1 ──"
    grep -v '^[[:space:]]*$' "$2" | tail -n 40 | sed 's/^/[pre-push]   │ /'
}

# Worktree nova não tem node_modules, vendor/, .env nem docs/data. Instala os dois primeiros
# DENTRO dela; copia o .env; liga docs/data (só dado) por symlink.
preparar() {
    alvo="$1"
    logs="$2"

    if [ -f "$alvo/backend/composer.json" ]; then
        if [ -f "$raiz/backend/.env" ]; then
            cp "$raiz/backend/.env" "$alvo/backend/.env"
        elif [ -f "$principal/backend/.env" ]; then
            cp "$principal/backend/.env" "$alvo/backend/.env"
        fi
        echo "[pre-push]   composer install (vendor próprio)…"
        ( cd "$alvo/backend" && composer install --no-interaction --prefer-dist --no-progress ) \
            > "$logs/composer-install.log" 2>&1 || {
            echo "[pre-push] ✗ composer install falhou na worktree temporária"
            mostrar_log composer-install "$logs/composer-install.log"
            return 1
        }
    fi

    if [ -f "$alvo/frontend/package.json" ]; then
        echo "[pre-push]   bun install --frozen-lockfile (node_modules próprios)…"
        ( cd "$alvo/frontend" && bun install --frozen-lockfile ) \
            > "$logs/bun-install.log" 2>&1 || {
            echo "[pre-push] ✗ bun install falhou na worktree temporária"
            mostrar_log bun-install "$logs/bun-install.log"
            return 1
        }
    fi

    # docs/data é dado real do posto (§6, gitignored) lido pelo golden. Symlink só aqui dentro.
    if [ -d "$alvo/docs" ]; then
        for origem in "$raiz/docs/data" "$principal/docs/data"; do
            if [ -e "$origem" ]; then
                ln -sfn "$(readlink -f "$origem")" "$alvo/docs/data"
                break
            fi
        done
    fi
    return 0
}

# ── 3. os gates, rodados dentro da worktree temporária ─────────────────────────
# $1 = raiz a testar · $2 = rótulo · $3 = pasta de logs
rodar_gates() {
    alvo="$1"
    rotulo="$2"
    logs="$3"
    local_falhou=0

    if [ -d "$alvo/frontend" ]; then
        cd "$alvo/frontend" || return 1

        echo "[pre-push] $rotulo · oxlint (inclui o gate de complexidade do §6)…"
        bun run lint > "$logs/oxlint.log" 2>&1 || {
            echo "[pre-push] ✗ oxlint reprovou — rode 'bun run lint'"
            mostrar_log oxlint "$logs/oxlint.log"; local_falhou=1; }

        echo "[pre-push] $rotulo · type-check…"
        bun run type-check > "$logs/type-check.log" 2>&1 || {
            echo "[pre-push] ✗ type-check reprovou"
            mostrar_log type-check "$logs/type-check.log"; local_falhou=1; }

        echo "[pre-push] $rotulo · testes unitários (vitest)…"
        bun run test > "$logs/vitest.log" 2>&1 || {
            echo "[pre-push] ✗ 'bun run test' reprovou"
            mostrar_log vitest "$logs/vitest.log"; local_falhou=1; }

        # O golden é a trava do dinheiro. NUNCA trocar por 'bun test' puro: ele varre o repo
        # inteiro, tenta executar os arquivos de vitest e falha por motivo que não é bug.
        echo "[pre-push] $rotulo · golden masters (bun run test:golden)…"
        bun run test:golden > "$logs/golden.log" 2>&1 || {
            echo "[pre-push] ✗ GOLDEN MASTER REPROVOU — alguma fórmula de dinheiro mudou de resultado."
            echo "[pre-push]   Isto não se resolve ajustando o teste. Rode 'bun run test:golden' e leia."
            mostrar_log golden "$logs/golden.log"
            local_falhou=1
        }
    fi

    if [ -f "$alvo/backend/composer.json" ]; then
        cd "$alvo/backend" || return 1
        echo "[pre-push] $rotulo · composer gates (Pint, PHPStan, PHPMD, Deptrac, Pest)…"
        composer gates > "$logs/composer-gates.log" 2>&1 || {
            echo "[pre-push] ✗ 'composer gates' reprovou — rode em backend/"
            mostrar_log composer-gates "$logs/composer-gates.log"; local_falhou=1; }
    fi

    cd "$raiz" || return 1
    return "$local_falhou"
}

# ── 4. testa CADA ref que está subindo, no commit que está subindo ─────────────
# A worktree fica em ~/.cache, no mesmo disco do cache do bun (instala por hardlink, o que
# não atravessa para o /tmp em tmpfs). Não pode ficar dentro de .git/: o vitest não carrega
# arquivo cujo caminho passa por .git ("Cannot find module '/apps/web/...'").
base_tmp="${XDG_CACHE_HOME:-$HOME/.cache}/posto-pre-push"
mkdir -p "$base_tmp" || exit 1
while read -r _ref_local sha_local ref_remoto _sha_remoto; do
    # Deleção de branch remota não tem árvore para testar.
    [ -z "$sha_local" ] && continue
    [ "$sha_local" = "$ZERO" ] && continue

    nome="${ref_remoto#refs/heads/}"
    curto="$(git rev-parse --short "$sha_local" 2>/dev/null || echo "$sha_local")"
    echo "[pre-push] $nome ($curto): testando o commit que sobe numa worktree temporária —"
    echo "[pre-push]   a árvore de onde se empurra não conta."

    wt="$(mktemp -d "$base_tmp/wt.XXXXXX")" || { falhou=1; continue; }
    echo "$wt" >> "$temporarios"
    rmdir "$wt"
    if ! git worktree add --detach --quiet "$wt" "$sha_local" >/dev/null 2>&1; then
        echo "[pre-push] ✗ não consegui criar worktree para $nome — não dá para afirmar que está verde."
        falhou=1
        continue
    fi
    # Logs fora da árvore testada, para não virarem arquivo não rastreado lá dentro.
    logs="$wt.logs"
    mkdir -p "$logs"
    echo "$logs" >> "$temporarios"

    if preparar "$wt" "$logs"; then
        rodar_gates "$wt" "$nome" "$logs" || falhou=1
    else
        falhou=1
    fi

    # Solta esta já, sem esperar o trap: push com várias refs não acumula worktrees.
    git worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
    rm -rf "$logs"
done < "$refs"

if [ "$falhou" -ne 0 ]; then
    echo ""
    echo "[pre-push] ══════════════════════════════════════════════════════════════"
    echo "[pre-push] PUSH BLOQUEADO: o sistema não está rodando."
    echo "[pre-push] Conserte antes de subir — tem posto em produção do outro lado."
    echo "[pre-push] ══════════════════════════════════════════════════════════════"
    exit 1
fi

echo "[pre-push] ✓ sistema verde nos commits que sobem — push liberado."
exit 0
